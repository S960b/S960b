[Unit]
Description=Cloudflared quick tunnel for Hermes<->ChatGPT bridge (8765)
After=network-online.target hermes-bridge.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/kali/hermes-chat-bridge/cloudflared tunnel --url http://127.0.0.1:8765 --no-autoupdate
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/kali/.local/state/hermes-bridge/cloudflared_pilot.log
StandardError=append:/home/kali/.local/state/hermes-bridge/cloudflared_pilot.log

[Install]
WantedBy=default.target
