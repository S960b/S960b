# Once per minute, ask the guarded paper trial if a NEW archive-backed
# qualifying event exists. The service condition stops invocations after
# the first irreversible frozen-input snapshot has been written.
[Unit]
Description=NEWS Tier-2 await first eligible fresh news event (PAPER ONLY)

[Timer]
OnCalendar=minutely
Persistent=true
AccuracySec=5s
Unit=news-phase4-tier2-trial.service

[Install]
WantedBy=timers.target
