# Only process existing paper trial outcomes; never call an inference model.
# This check is a no-op while Tier-2 has no trial DB (our current state).
[Unit]
Description=NEWS Tier-2 existing-triple four-hour outcome settlement
Wants=network-online.target
After=network-online.target
ConditionPathExists=/home/kali/.local/share/news-phase4-v25/tier2.sqlite

[Service]
Type=oneshot
WorkingDirectory=/home/kali/research/news_phase4_v25_release/research/news_phase4_v21
Environment=PYTHONPATH=/home/kali/research/news_phase4_v25_release/research/news_phase4_v21/source:/home/kali/research/news_phase4_v25_release/research/news_phase4_v21/source/v22_live
UMask=0077
ExecStart=/usr/bin/python3 /home/kali/research/news_phase4_v25_release/research/news_phase4_v21/source/v22_live/tier2_label_watch.py --settle
TimeoutStartSec=180s
